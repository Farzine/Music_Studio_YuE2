# ---------------------------------------------------------------------------
# YuE2 Music Studio — local-first configuration
# Copy to .env and adjust. Nothing here is baked into the source.
# ---------------------------------------------------------------------------
APP_ENV=development

# API process
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://127.0.0.1:3000

# Frontend -> API (read by Next.js)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Local model locations. Absolute paths, or Hugging Face repo ids when the
# machine is allowed to download. Leave YUE2_MODEL_PATH empty to fall back to
# the repo id and let huggingface-hub resolve it.
YUE2_MODEL_PATH=./models/YuE2-3B
YUE2_MODELS_DIR=./models
YUE2_VAE_PATH=./models/YuE2-Vae
YUE2_VAE_LEGACY_PATH=./models/YuE2-Vae-legacy
SHEETSAGE2_MODEL_PATH=./models/SheetSage2

# Model revisions used for reproducible comparisons. Empty means "whatever the
# local directory contains", which is recorded in each manifest by hash.
YUE2_MODEL_REVISION=
YUE2_VAE_REVISION=

# Data root: projects, generations, jobs, uploads, presets. No database.
DATA_DIR=./data
# Where the parameter registry, defaults, presets and capabilities are read from.
CONFIGS_DIR=./configs

# Worker
# Which GPU runs the model is chosen on the System page and stored in
# data/runtime-settings.json, so it can be changed without a restart.
#
# CUDA_VISIBLE_DEVICES is deliberately NOT read from this file: it is a driver
# variable that must be exported into the worker's shell environment to have
# any effect. Export it there only if you want to hide devices entirely; doing
# so also renumbers the ones that remain, and the System page will say so.
MAX_CONCURRENT_GPU_JOBS=1
WORKER_ID=local-gpu-0
WORKER_POLL_INTERVAL_SECONDS=0.5
# Normal API exit requests worker cleanup; dev_api.sh --reload defaults this off.
WORKER_SHUTDOWN_ON_API_EXIT=true
WORKER_SHUTDOWN_TIMEOUT_SECONDS=60
# native | mock | comfy
YUE2_BACKEND=native
# Keep the 7.26 GB checkpoint resident between jobs. Seconds; 0 = never unload.
MODEL_IDLE_UNLOAD_SECONDS=0
AUDIOCPP_CLI_PATH=./tools/audio.cpp/build/bin/audiocpp_cli
# Passed to YuE2Pipeline. The A6000 has 48 GiB; 24 is the documented baseline.
YUE2_MEMORY_BUDGET_GIB=40
# torch | torch-eager | vllm
YUE2_COMPUTE_BACKEND=torch
# none | fp8
YUE2_QUANTIZATION=none
YUE2_OFFLOAD_AR=false
YUE2_LOCAL_FILES_ONLY=true

# Hardware recommendation estimates (GiB where specified), not inference limits.
# Reserve the larger of this fraction of total VRAM and the fixed GiB margin.
MODEL_VRAM_SAFETY_FRACTION=0.20
MODEL_VRAM_SAFETY_GIB=1
MODEL_RUNTIME_OVERHEAD_GIB=2
MODEL_UNKNOWN_KV_GIB=2
MODEL_UNKNOWN_VAE_GIB=2
MODEL_WEIGHT_OVERHEAD_FACTOR=1.25

# Optional ComfyUI compatibility adapter (reference layer, off by default)
COMFY_API_URL=
COMFY_WORKFLOW_PATH=./yue2_full.json

# Uploads
MAX_UPLOAD_BYTES=104857600

# How often a running job re-reads its record to notice a cancellation request.
CANCEL_POLL_INTERVAL_SECONDS=0.25

# Cover workflow (optional)
SHEETSAGE2_MODEL_PATH=./models/SheetSage2
SHEETSAGE2_VENV=./.venv-sheetsage2
SHEETSAGE2_TIMEOUT_SECONDS=1800
FFMPEG_DIR=./tools/ffmpeg
